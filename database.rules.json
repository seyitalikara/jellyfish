{
  "rules": {
    "clubSecrets": {
      "$code": {
        "adminHash": {
          ".read": false,
          ".write": "auth != null && !data.exists() && newData.isString() && newData.val().length === 64"
        }
      }
    },
    "memberSecrets": {
      "$code": {
        "$memberId": {
          ".read": false,
          ".write": "auth != null && !newData.exists() && root.child('clubs').child($code).child('admins').child(auth.uid).exists()",
          "hash": {
            ".read": false,
            ".write": "auth != null && !data.exists() && newData.isString() && newData.val().length === 64"
          }
        }
      }
    },
    "reportFiles": {
      "$code": {
        "$memberId": {
          "$fileId": {
            ".read": "auth != null && (root.child('clubs').child($code).child('admins').child(auth.uid).exists() || root.child('clubs').child($code).child('memberUids').child($memberId).child(auth.uid).exists())",
            ".write": "auth != null && (root.child('clubs').child($code).child('admins').child(auth.uid).exists() || (root.child('clubs').child($code).child('memberUids').child($memberId).child(auth.uid).exists() && (!data.exists() || data.child('meta').child('by').val() === 'member') && (!newData.exists() || newData.child('meta').child('by').val() === 'member')))",
            "meta": {
              ".validate": "newData.hasChildren(['name', 'size', 'chunks', 'by']) && newData.child('size').isNumber() && newData.child('size').val() <= 10485760 && newData.child('chunks').isNumber() && newData.child('chunks').val() <= 64"
            },
            "chunks": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 400000"
              }
            }
          }
        }
      }
    },
    "clubs": {
      "$code": {
        "id": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('clubs').child($code).child('admins').child(auth.uid).exists())"
        },
        "name": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('clubs').child($code).child('admins').child(auth.uid).exists())"
        },
        "createdAt": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('clubs').child($code).child('admins').child(auth.uid).exists())"
        },
        "adminPass": {
          ".read": false,
          ".write": "auth != null && !newData.exists() && root.child('clubs').child($code).child('admins').child(auth.uid).exists()"
        },
        "admins": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('clubSecrets').child($code).child('adminHash').val()"
          }
        },
        "memberUids": {
          "$memberId": {
            ".write": "auth != null && !newData.exists() && root.child('clubs').child($code).child('admins').child(auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('memberSecrets').child($code).child($memberId).child('hash').val()"
            }
          }
        },
        "reports": {
          ".read": "auth != null && root.child('clubs').child($code).child('admins').child(auth.uid).exists()",
          "$memberId": {
            ".read": "auth != null && root.child('clubs').child($code).child('memberUids').child($memberId).child(auth.uid).exists()",
            "$reportId": {
              ".write": "auth != null && (root.child('clubs').child($code).child('admins').child(auth.uid).exists() || (root.child('clubs').child($code).child('memberUids').child($memberId).child(auth.uid).exists() && !root.child('clubs').child($code).child('feedback').child($memberId).child($reportId).exists()))",
              ".validate": "newData.hasChildren(['title', 'fileId', 'fileName', 'uploadedAt']) && newData.child('memberId').val() === $memberId && newData.child('title').isString() && newData.child('title').val().length <= 200"
            }
          }
        },
        "feedback": {
          ".read": "auth != null && root.child('clubs').child($code).child('admins').child(auth.uid).exists()",
          "$memberId": {
            ".read": "auth != null && root.child('clubs').child($code).child('memberUids').child($memberId).child(auth.uid).exists()",
            "$reportId": {
              ".write": "auth != null && root.child('clubs').child($code).child('admins').child(auth.uid).exists()",
              ".validate": "newData.hasChildren(['text', 'status', 'at'])"
            }
          }
        },
        "teams": {
          ".read": "auth != null",
          "$teamId": {
            ".write": "auth != null && root.child('clubs').child($code).child('admins').child(auth.uid).exists()",
            "members": {
              "$memberId": {
                ".write": "auth != null && newData.exists() && root.child('clubs').child($code).child('teams').child($teamId).child('id').exists() && (!data.exists() || data.child('uid').val() === auth.uid)"
              }
            },
            "tasks": {
              "$taskId": {
                ".write": "auth != null && newData.exists() && root.child('clubs').child($code).child('teams').child($teamId).child('id').exists()"
              }
            }
          }
        },
        "notifications": {
          ".read": "auth != null",
          "$notifId": {
            ".write": "auth != null && newData.exists()"
          }
        }
      }
    }
  }
}
